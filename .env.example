# Avito API (ключ от аккаунта КОМПАНИИ, подписка «Расширенный»/«Максимальный»)
AVITO_CLIENT_ID=
AVITO_CLIENT_SECRET=
AVITO_USER_ID=
AVITO_WEBHOOK_SECRET=
# Белый список объявлений, на которые отвечает бот (через запятую). Пусто = все
AVITO_ITEM_IDS=

# Neon PostgreSQL
DATABASE_URL=

# OpenRouter
OPENROUTER_API_KEY=
LLM_MODEL=google/gemini-2.5-flash

# DaData — данные ЕГРЮЛ по ИНН (быстрое добавление и проверка карточек)
DADATA_API_KEY=
DADATA_SECRET_KEY=

# Бот
BOT_TONE=вы

# Telegram: бот владельца (алерты + рабочий бот с базой компаний)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Секрет заголовка вебхука Telegram (X-Telegram-Bot-Api-Secret-Token)
TELEGRAM_WEBHOOK_SECRET=
# chat_id админов бота через запятую; по умолчанию берётся TELEGRAM_CHAT_ID
TELEGRAM_ADMIN_IDS=
# Что видит пользователь без роли partner: full | anonymous | closed
TELEGRAM_GUEST_ACCESS=anonymous

# Админка (Basic Auth)
ADMIN_USER=
ADMIN_PASSWORD=

# Базовый URL приложения (для ссылок в Telegram-алертах), напр. https://avito-bot.vercel.app
APP_URL=
